// Ustawienia projektu - wszystko w jednym miejscu, wczytuje je src/config.py.
// Składnia JSON: true / false / null małymi literami, tekst w "...", liczby z kropką,
// bez przecinka po ostatnim elemencie. Komentarze // są dozwolone.
// Brakujący klucz = wartość domyślna z kodu, więc można usuwać linie, których nie zmieniasz.

{
  // -----------------
  // Zestaw danych - każdy zestaw to podfolder o tej samej nazwie w trzech folderach z "paths":
  //   scanned_bones/<zestaw>/  skany,   out/3d/<zestaw>/  wyniki,   contacts/<zestaw>/  oznaczenia styku.
  // Nowy zestaw = nowy folder w scanned_bones/ ze skanami. Lista zestawów: python scripts/datasets.py
  // Jednorazowo inny zestaw w każdym skrypcie: --dataset <nazwa> (krócej: -d <nazwa>).
  // Zestaw może mieć własne ustawienia: scanned_bones/<zestaw>/settings.json - te same sekcje co tu,
  // nadpisują tylko podane klucze (np. {"merging": {"enabled": false}}).
  // -----------------
  "dataset": "grzesiu_test",

  // -----------------
  // Foldery (względem głównego folderu projektu) - w każdym z nich podfoldery zestawów
  // -----------------
  "paths": {
    "data_in": "scanned_bones",   // surowe skany (.ply/.obj/.stl): <zestaw>/<kość>/<plik skanu>
    "data_out": "out/3d",         // wyniki - generowane, można je usunąć i policzyć od nowa
    "contacts": "contacts",       // powierzchnie styku: ręczne (commituj!) + podfolder auto/ (generowane)
    "presentations": "raporty/prezentacje",  // prezentacje (scripts/presentation.py), podfolder na każdy zestaw
    // Atlas anatomiczny (sekcja "atlas") - wspólny dla wszystkich zestawów:
    "atlas": "atlas",             // pliki modeli KOMPLETNYCH kości (.ply/.obj/.stl) - potrzebne tylko do zindeksowania
    "atlas_index": "atlas_index"  // zindeksowana baza (~1 MB na kość) - z niej korzysta wykrywanie; oryginały można usunąć
  },

  // -----------------
  // Wczytywanie skanów - scripts/prepare_data.py
  // -----------------
  "scans": {
    // Kolejność wyboru formatu, gdy ten sam skan jest w kilku plikach (PLY: najmniejszy, ma kolory).
    "preferred_formats": ["ply", "obj", "stl"],

    // Pomiń skany, których ścieżka zawiera któryś z tych tekstów (bez wielkości liter).
    // "occlusion" = skan zgryzu Medit: dwa fragmenty złożone RAZEM - skleiłby dwie kości w jedną.
    "exclude": ["occlusion"],

    // Oderwany kawałek skanu jest szumem, jeśli jest mniejszy niż ten ułamek największego
    // albo dalej od niego niż max_component_gap_au - chyba że potwierdzają go inne skany tej kości.
    "min_component_area_ratio": 0.05,
    "max_component_gap_au": 10
  },

  // -----------------
  // Łączenie skanów tej samej kości - src/merging.py
  // Po zmianie uruchom ponownie prepare_data.py (wyniki par są w cache, więc szybko).
  // -----------------
  "merging": {
    "enabled": false,            // false = każdy skan to osobna kość

    // Dwa skany = ta sama kość, gdy co najmniej taka część mniejszego leży na drugim
    // (bliżej niż tolerance_au, normalne w tę samą stronę). Różne fragmenty: ~0.05-0.16,
    // ten sam fragment: ~0.35-0.6.
    // należy to zmienić jeśli zestaw kości ma inne przełomy (inną skalę)
    "min_overlap": 0.25,
    "tolerance_au": 0.15,

    // Kawałek skanu potwierdzony przez inne skany kości w mniejszej części niż to = szum.
    "min_support": 0.25,

    // "union"   = skan referencyjny + brakujące miejsca z innych skanów (oryginalna geometria),
    // "poisson" = jedna gładka powierzchnia (rekonstrukcja Poissona, lekko wygładza).
    "fuse_method": "union",
    "poisson_depth": 9,

    "sample_au": 0.25,         // odstęp punktów do porównywania skanów (dokładność chmury) [a.u.]
    "coarse_voxel_au": 1.0,    // rozdzielczość zgrubnej rejestracji (FPFH + RANSAC) [a.u.]
    "ransac_seeds": 3,         // prób zgrubnej rejestracji na parę (więcej = pewniej, wolniej)
    "ransac_iterations": 50000,

    // null = grupy automatyczne. Ręcznie: {"nazwa kości": ["fragment nazwy skanu", ...]},
    // np. {"strzalkowa_A": ["whole_scan-lowerjaw", "whole_lower_rescan"]}.
    // Osobno dla zestawów: {"first_scans": {"strzalkowa_A": [...]}, "inny_zestaw": {...}}.
    // Nazwy skanów wypisuje prepare_data.py. Skany spoza listy są grupowane automatycznie.
    "groups": null
  },

  // -----------------
  // Chmura punktów i deskryptory FPFH kości (do dopasowania) - src/bones.py
  // -----------------
  "features": {
    "center": true,             // przesuń kość tak, żeby jej środek był w (0, 0, 0)
    "voxel_size": 0.5,          // odstęp punktów chmury [a.u.]
    "sampling_density": 4,      // punktów losowanych na voxel^2 przed przerzedzeniem
    "fpfh_radius_factor": 5.0   // promień FPFH = ta liczba x voxel_size (2.5 a.u.)
  },

  // -----------------
  // Powierzchnie styku (przełomy) - src/contacts.py
  //   ręcznie:   scripts/mark_contacts.py   -> contacts/<zestaw>/<id kości>.json       (w repozytorium)
  //   algorytm:  scripts/detect_contacts.py -> contacts/<zestaw>/auto/<id kości>.json  (generowane)
  // -----------------
  "contacts": {
    // Narzędzie do ręcznego oznaczania
    "port": 8765,               // port lokalnego serwera narzędzia
    "brush_au": 2.0,            // startowy promień pędzla [a.u.]
    "wand_angle_deg": 25,       // startowa tolerancja kąta "różdżki" (zaznacza obszar do ostrej krawędzi)

    // Algorytm wykrywania - używany przez detect_contacts.py, narzędzie (kość bez ręcznych oznaczeń
    // startuje od jego wyniku = "ustawienie automatyczne"; przycisk "Propozycja algorytmu")
    // i dopasowanie w trybie "auto" / "manual-auto". Po zmianie któregokolwiek
    // ustawienia poniżej dopasowanie samo policzy wyniki algorytmu od nowa.
    "method": "atlas",      // nazwa algorytmu (@detector w src/contacts.py): "roughness", "features" albo "atlas"
                               // ("atlas" = "features" + baza kompletnych kości, sekcja "atlas" niżej)
    "min_surface_au2": 15.0,    // oba algorytmy: mniejsze wykryte obszary są pomijane [a.u.²]

    // "roughness" = algorytm bazowy: przełom to szorstka powierzchnia, kora kości gładka (słaby!)
    "roughness_radius_au": 1.0, // promień sąsiedztwa do liczenia szorstkości [a.u.]
    "rough_threshold": 0.09,    // od tej szorstkości powierzchnia = przełom (kora ~0.04, gąbczasty przełom ~0.15)

    // "features" = kilka cech naraz, BEZ oznaczeń: przełom jest bardziej szorstki, ma większy rozrzut
    // normalnych i gęstszą siatkę niż reszta TEJ SAMEJ kości (mediana kości = kora).
    // Cechy i ich promienie: sekcja "surface_features"; opis cech: raporty/przelom_vs_kora.md.
    "feature_keys": ["spread_2", "rough_1", "edge_au"],  // rozrzut normalnych 2 a.u., szorstkość 1 a.u., krawędź siatki
    "feature_threshold": 0.15,  // o ile ponad typową wartość tej kości (w odchyleniach) = przełom (wyżej = mniej, ale pewniej)
    "feature_smooth_au": 1.0,   // uśrednianie wyniku w tym promieniu przed progiem [a.u.] (0 = bez)
    "feature_open_au": 1.0,     // otwarcie morfologiczne [a.u.]: rozcina wąskie mostki między obszarami (więcej = więcej kawałków)

    // Po KAŻDYM algorytmie (contacts.refine_surfaces):
    //   1. kość długa (fragment co najmniej long_min_elongation razy dłuższy niż szerszy): powierzchnia sięgająca
    //      obu połówek fragmentu = dwa przełomy połączone pasem kory -> dzielona na dwie (split_ends),
    //   2. każdą powierzchnię przybliża płaszczyzna ("plane") albo funkcja kwadratowa ("quadric"); na kości długiej
    //      liczą się głównie punkty patrzące wzdłuż osi (twarz przełomu), a nie kora z boku,
    //   3. zostają tylko punkty bliżej przybliżenia niż fit_tolerance_au - rękaw kory wzdłuż kości odpada.
    // Opis przybliżenia każdej powierzchni (normalna, odchylenie od płaszczyzny) trafia do wyniku ("info" -> "fits").
    "surface_fit": "plane",     // "plane" / "quadric" / "none" (= bez przybliżenia i odcinania)
    "split_ends": true,
    "fit_tolerance_au": 3.0,    // [a.u.]; więcej = zostaje więcej kory przy końcu, mniej = ryzyko obcięcia nierównego przełomu
    "long_min_elongation": 2.5,
    //   4. GŁOWA KOŚCI: koniec, przy którym fragment jest szerszy niż trzon (promień skrajnych 12% długości / promień
    //      środka >= head_min_ratio), to nasada / głowa - obszary od head_zone do tego końca odpadają.
    //      Przełom trzonu zwęża fragment (grzesiu_test: 0.5-0.85), głowy 1.2-1.4. 0 = bez.
    "head_min_ratio": 1.1,
    "head_zone": 0.3,
    //   5. OSTRE KRAWĘDZIE KORY: obszar z normalnymi w bok (średnie |n . oś| < crest_max_axial) i prawie płaski
    //      (odchylenie od płaszczyzny < crest_max_rms_au) to grzebień / krawędź wzdłuż trzonu, nie przełom. 0 = bez.
    "crest_max_axial": 0.2,
    "crest_max_rms_au": 0.35,

    // Kości, dla których algorytm NIE liczy powierzchni styku (np. całe, nieprzełamane kości):
    // id albo nazwa zawiera któryś z tekstów (bez wielkości liter i polskich znaków, spacja = "_").
    // Ręczne oznaczenia tych kości nadal działają. Osobno dla zestawu: scanned_bones/<zestaw>/settings.json.
    "exclude": ["cała kość"]
  },

  // -----------------
  // Atlas anatomiczny: baza modeli KOMPLETNYCH kości - src/atlas.py
  //   python scripts/build_atlas.py       indeksuje pliki z "paths" -> "atlas" (robi się też samo)
  //   python scripts/identify_bones.py    z której kości pochodzi każdy fragment (+ atlas.html)
  //   algorytm "atlas" (sekcja "contacts" -> "method", albo detect_contacts.py --method atlas):
  //   kora = leży na powierzchni dopasowanego modelu, przełom = wnętrze kości (też kanał szpikowy).
  // Długości w a.u. skanu. Po zmianie dopasowania liczą się od nowa same (cache w out/3d/<zestaw>/cache/atlas/).
  // -----------------
  "atlas": {
    // Skala: model może być w innych jednostkach i innej wielkości osobniczej niż skan
    "reference_scale": 1.0,     // ile a.u. skanu to 1 jednostka modelu (model w mm, skan w a.u. ~ mm -> 1)
    "scale_range": [0.75, 1.35],// dopuszczalna skala względem reference_scale (różnice osobnicze, kalibracja skanera)
    "mirror": true,             // sprawdzaj też odbicie lustrzane modelu (kość z drugiej strony ciała)
    // Wspólna skala zestawu: fragmenty jednej osoby mają tę samą skalę względem modelu. Liczy ją
    // python scripts/identify_bones.py (mediana), a z --shared-scale zapisuje jako "model_scales"
    // w scanned_bones/<zestaw>/settings.json - wtedy skala modelu tylko w zakresie ± shared_scale_tolerance.
    "shared_scale_tolerance": 0.1,
    // Czy zestaw jest od jednej osoby: true = zawsze wspólna skala, false = nigdy (każdy fragment swoją),
    // "auto" = nie wiadomo: wspólna skala tylko, gdy fragmenty się co do niej zgadzają (60% wagi w ±10%).
    // Ustawia ją python scripts/identify_bones.py (osobno dla zestawu: scanned_bones/<zestaw>/settings.json).
    "one_person": "auto",

    // Sito własności - PRZED dopasowaniem wyklucza kości, które na pewno nie pasują (rozmiar, krzywizny)
    "curvature_radius_au": 2.5, // promień liczenia krzywizn [a.u.] (zmiana = baza liczona od nowa)
    "size_tolerance": 0.15,     // zapas na różnice osobnicze w długości i polu (0.15 = 15%)
    "max_unexplained": 0.2,     // wyklucz kość, gdy taka część kory fragmentu nie ma odpowiednika na żadnym jej kawałku
    "max_models": 5,            // najwięcej kości po sicie do dokładnego dopasowania
    "scale_candidates": 2,      // ile najlepszych skal z sita sprawdzać na kość

    // Dopasowanie (RANSAC na FPFH + ICP ze skalą)
    "voxel_au": 1.0,            // odstęp punktów zgrubnego ustawienia [a.u.] (zmiana = baza liczona od nowa)
    "fpfh_radius_au": 5.0,      // promień deskryptora kształtu FPFH [a.u.]
    "ransac_iterations": 200000,// iteracji RANSAC na skalę i odbicie
    "ransac_seeds": 1,          // niezależnych prób RANSAC (wygrywa najlepsza)
    "icp_iterations": 30,       // kroków ICP ze skalą

    // Ocena i prawdopodobieństwa
    "tolerance_au": 1.0,        // KORA = fragment bliżej powierzchni modelu niż to [a.u.] ...
    "normal_angle_deg": 40.0,   // ... z normalnymi zgodnymi z dokładnością do tego kąta
    "outside_penalty": 1.0,     // kara za część fragmentu wystającą NA ZEWNĄTRZ modelu (dobra kość: nic nie wystaje)
    "min_fit": 0.55,            // ocena "żadna z bazy": kości dopasowane gorzej są mniej prawdopodobne niż brak dopasowania
    "temperature": 0.05,        // rozmycie prawdopodobieństw (mniej = ostrzej, więcej = ostrożniej)
    "top_k": 3,                 // ile najbardziej prawdopodobnych kości rozstrzyga, co jest korą, a co przełomem

    // Łączenie z analizą lokalną (szorstkość, rozrzut normalnych, gęstość siatki - jak "features")
    "atlas_weight": 2.0,        // waga atlasu względem analizy lokalnej (więcej = atlas ważniejszy)
    "local_scale": 0.3,         // tyle wyniku "features" ponad feature_threshold = 1 jednostka log-szans
    "min_confidence": 0.8,      // pewność atlasu (suma p najlepszych kości) poniżej tego = sama analiza lokalna
    "cavity_weight": 3.0,       // wgłębienie (kanał szpikowy - na skanie wklęsły dół) = przełom z tą siłą; 0 = bez
    "cavity_occlusion": 0.55,   // od takiej części zasłoniętych promieni punkt leży we wgłębieniu
    "cavity_depth_au": 15.0     // promień trafiający w siatkę dalej niż to nie zasłania [a.u.]
  },

  // -----------------
  // Dopasowanie fragmentów po powierzchniach styku - scripts/match_surfaces.py, src/matching_surfaces.py
  // Każda powierzchnia styku jest ustawiana (RANSAC + ICP) na każdej powierzchni innej kości,
  // twarzą w twarz; wynik pary = pole styku - pole kolizji [a.u.²].
  // -----------------
  "matching": {
    // Skąd powierzchnie styku:
    //   "manual"      = tylko ręczne (contacts/<zestaw>/<id>.json); kości bez nich są pomijane,
    //   "auto"        = tylko z algorytmu (sekcja "contacts"): z contacts/<zestaw>/auto/, a gdy brak
    //                   albo nieaktualne - liczone i zapisywane; bazowy "roughness" jest słaby,
    //   "manual-auto" = ręczne, a dla kości bez ręcznych - z algorytmu.
    // Jednorazowo: python scripts/match_surfaces.py --source auto
    "source": "auto",
    "min_area_au2": 20.0,       // mniejsze powierzchnie styku są pomijane [a.u.²]
    // Wynik pary: "dice" = (styk - kolizja) / średnie pole obu przełomów [%] - jaka część OBU przełomów do siebie
    // przylega (część, która nic nie dotyka, obniża wynik; duże fragmenty nie wygrywają samym polem),
    // "area" = styk - kolizja [a.u.²] (dawny wynik - rośnie z wielkością przełomów)
    "score_mode": "dice",

    // Punkty i deskryptory
    "sample_au": 0.3,           // odstęp punktów powierzchni (do ICP) [a.u.]; mniej = dokładniej, wolniej
    "coarse_voxel_au": 1.0,     // odstęp punktów do zgrubnego ustawienia (RANSAC) [a.u.]
    "fpfh_radius_au": 4.0,      // promień deskryptora kształtu FPFH [a.u.]; ~ wielkość charakterystycznych nierówności przełomu

    // Zgrubne ustawienie: RANSAC losuje trójki podobnych punktów (wg FPFH) i sprawdza, ile pasuje
    "ransac_iterations": 1000000, // zawsze wszystkie (bez wczesnego końca): 50 tys. trafia dobre ustawienie ~40% prób, 1 mln ~100%
    "ransac_seeds": 2,          // ile niezależnych prób RANSAC na parę (wygrywa najlepsza); czas rośnie liniowo
    "ransac_normal_angle_deg": 35.0, // RANSAC odrzuca ustawienia, w których normalne par punktów różnią się bardziej

    // Dokładne ustawienie: ICP dociska powierzchnie, szukając par punktów najpierw do icp_start_au,
    // potem do połowy tej odległości, na koniec do 2 x sample_au
    "icp_start_au": 2.0,

    // Ocena ustawienia
    "tolerance_au": 0.5,        // STYK: punkty bliżej niż to ...
    "normal_angle_deg": 45.0,   // ... i z normalnymi przeciwnymi z dokładnością do tego kąta [stopnie]
    "collision_au": 1.0,        // KOLIZJA: punkt jednej kości głębiej niż to pod powierzchnią drugiej [a.u.]
    "collision_search_au": 4.0, // ... szukane tylko w tej odległości od powierzchni drugiej kości [a.u.]

    // Atlas anatomiczny (sekcja "atlas"): z której kompletnej kości z bazy pochodzi każdy fragment i jak
    // na niej leży (ten sam cache co algorytm "atlas" i identify_bones.py). "Ta sama kość" = ten sam model
    // i strona ciała; modele w jednym podfolderze bazy (typ kości) liczą się razem, bez strony.
    // Jednorazowo: python scripts/match_surfaces.py --no-use-atlas  (albo --use-atlas)
    "use_atlas": true,
    "atlas_skip_different": 0.95, // POMIŃ parę, gdy atlas daje tyle szans, że to RÓŻNE kości (> 1 = nie pomijaj)
    "atlas_starts": 2,          // START: najwięcej ustawień startowych z atlasu na parę (fragmenty na wspólnym modelu); 0 = bez
    "atlas_boost": 0.25,        // PREMIA: styk liczy się o tyle mocniej, gdy to na pewno ta sama kość (0 = bez premii)

    // Płaskie cięcia: koniec spiłowany / przecięty piłą jest prawie płaski, przełom nierówny. Powierzchnia, której punkty
    // odchylają się od płaszczyzny średnio mniej niż to, NIE jest dopasowywana (dwa płaskie cięcia zawsze do siebie pasują).
    // Odchylenie każdej powierzchni wypisuje match_surfaces.py; 0 = nie pomijaj [a.u.]
    "flat_max_rms_au": 0.0,

    // Tryb dopasowania: "points" = RANSAC + ICP na punktach przełomów; "plane" = do testów: same przybliżenia
    // płaszczyzną (płaszczyzna na płaszczyźnie, obrót co 360°/plane_steps, styk = wspólna część obrysów)
    "mode": "points",
    "plane_steps": 36,

    // Proponowane złożenie: tylko pary z wynikiem co najmniej tyle (słabszych nie wciska na siłę - przełom zostaje
    // bez pary, np. gdy brakuje kawałka pomiędzy) [jednostka wyniku: % przy "dice"]
    "assembly_min_score": 10.0,
    // ... i (jak w OSTEOFORM) pokrycie KAŻDEJ strony co najmniej tyle, kolizja najwyżej taka część styku
    "assembly_min_cover": 0.2,
    "assembly_max_collision": 0.25,
    // Składanie CAŁYCH GRUP (jak w OSTEOFORM): wiązka tylu częściowych złożeń; dołączana grupa jest przenoszona sztywno,
    // a połączenie odpada, gdy dwa fragmenty łączonych grup wchodzą w siebie (część punktów) bardziej niż
    // assembly_max_penetration. 0 = zachłannie, para po parze, bez sprawdzania całych grup.
    "assembly_beam": 12,
    "assembly_max_penetration": 0.06,

    // Starty płaszczyzna na płaszczyźnie (jak w OSTEOFORM): środki przybliżeń przełomów razem, normalne przeciwne,
    // obrót co 360°/plane_starts; plane_starts_keep najlepszych idzie do ICP (obok startów wzdłuż osi i RANSAC). 0 = bez
    "plane_starts": 24,
    "plane_starts_keep": 3,
    // Jakość (jak w OSTEOFORM): styk x 1/(1 + RMSE/tolerance_au) x exp(-kąt normalnych/45°) - ciasne dopasowanie wygrywa
    "quality_factor": true,
    // Pomiń pary, których pola przełomów różnią się więcej niż tyle razy (OSTEOFORM: 4); 0 = bez
    "max_area_ratio": 5.0,

    // Kości długie: kawałki trzonu łączą się KONIEC DO KOŃCA, wzdłuż jednej osi (nie pod kątem, nie koniec do boku).
    // Dotyczy par, w których OBA fragmenty są wydłużone (oś = kierunek, w którym fragment jest najdłuższy).
    "axis_check": true,
    "axis_min_elongation": 2.5, // fragment wydłużony = co najmniej tyle razy dłuższy niż szerszy
    "axis_max_deg": 8.0,        // OCENA: osie rozchodzą się do tylu stopni bez kary; przy 2x tyle styk się już nie liczy (20 przepuszczało złożenia pod kątem)
    "axis_max_offset": 1.0,     // ... osie rozsunięte w miejscu styku do tylu promieni kości bez kary (koniec do boku ~ 2)
    "axis_starts": 12,          // START: koniec do końca wzdłuż osi, obrót wokół osi co 360°/tyle (12 = co 30°); 0 = bez
    // PROSTOWANIE: najlepsze ustawienie pary kości długich jest prostowane (oś A na osi B, osie liczone przy przełomach -
    // głowa kości i wygięcie nie przekrzywiają osi) i dociskane ICP, w którym wolno tylko obracać wokół osi i przesuwać.
    // Wygrywa, jeśli ma lepszy wynik.
    "axis_lock": true,
    // OŚ JAKO WARUNEK SZUKANIA (nie tylko oceny): dla pary kości długich KAŻDY start (siatka ustawień na wprost,
    // starty wzdłuż osi, płaszczyzny, RANSAC) jest prostowany i dociskany ICP z obrotem tylko wokół wspólnej osi;
    // potem mały zwykły ICP, przyjęty tylko przy kącie osi <= axis_max_deg. false = oś tylko w ocenie.
    "axis_constrain": true,
    "constrain_grid_keep": 8,   // ... z siatki ustawień na wprost tyle najlepszych idzie do ICP
    "constrain_twist_deg": 15.0, // ... siatka: obrót wokół osi co tyle [stopnie]
    "constrain_step_au": 3.0,   // ... siatka: przesunięcie wzdłuż osi co tyle [a.u.]
    "constrain_ransac": false,  // ... dodatkowo RANSAC (szuka bez osi, wolny) - niepotrzebny przy osi jako warunku
    // Ocena kości długich: "contact" = ścisły styk przełomów (tolerance_au); "gap" = ODPORNA NA SZCZELINĘ:
    // osie w linii, A przedłuża B, szukane tylko obrót wokół osi i przesunięcie wzdłuż niej; wynik =
    // 0.5 x BLISKOŚĆ przełomów (bliżej niż gap_au) + 0.5 x CIĄGŁOŚĆ KORY (kora A przy przełomie na przedłużeniu
    // kory B: bliżej jej płaszczyzny niż continuity_au, normalne zgodne), minus kolizja.
    // Na grzesiu_test prawdziwe przełomy nawet w dobrym złożeniu są 2-3 a.u. od siebie - ścisły styk ich nie widzi.
    "long_mode": "contact",
    "gap_au": 2.5,              // przełomy bliżej niż to = blisko [a.u.]
    "rim_au": 6.0,              // kora przy przełomie = do tylu a.u. od niego
    "continuity_au": 0.8,       // kora A na przedłużeniu kory B = bliżej jej płaszczyzny stycznej niż to [a.u.]
    "gap_twist_deg": 15.0,      // szukanie: krok obrotu wokół osi [stopnie]
    "gap_shift_au": [-30.0, 15.0], // szukanie: przesunięcie wzdłuż osi (ujemne = końce zachodzą na siebie, spirala) [a.u.]
    "gap_step_au": 2.0,         // szukanie: krok przesunięcia [a.u.]

    // Starty z atlasu i wzdłuż osi (dokładane do RANSAC)
    "start_icp_au": 6.0,        // ICP z takiego startu szuka najpierw tak daleko (start jest przybliżony) [a.u.]
    "start_enough_cover": 0.35, // gdy start pokrył OBIE powierzchnie co najmniej w tylu (i osie się zgadzają) - bez RANSAC (> 1 = zawsze RANSAC)

    "max_shown": 15,            // ile najlepszych par pokazać w 3D (tune_matching.py --html -> matching.html)

    // Podgląd z suwakami (python scripts/tune_matching.py): zmiana suwaka przelicza wybraną parę
    "port": 8766                // port lokalnego serwera podglądu
  },

  // -----------------
  // Porównanie cech przełomu i kory - scripts/compare_surfaces.py -> out/3d/<zestaw>/surface_features.html
  // Ręcznie oznaczone powierzchnie styku vs reszta kości (kora): szorstkość, kształt, kolor, ...
  // -----------------
  "surface_features": {
    "radii_au": [0.5, 1.0, 2.0],  // promienie liczenia szorstkości i rozrzutu normalnych [a.u.]
    "boundary_margin_au": 1.0,    // pomiń pas przy otwartym brzegu skanu (postrzępiony, to nie przełom) [a.u.]
    "label_band_au": 0.5          // pomiń pas po obu stronach granicy oznaczenia (niedokładność ręcznego) [a.u.]
  },

  // -----------------
  // Syntetyczne kości pocięte na fragmenty - scripts/make_synthetic.py, src/synthetic_bones.py
  // Tworzy osobny zestaw (scanned_bones/<nazwa>/) z prawdą: które fragmenty pasują, gdzie są przełomy.
  // [od, do] = losowane osobno dla każdej kości. Długości w a.u.
  // -----------------
  "synthetic": {
    "n_bones": 6,               // ile kości
    "fragments": [2, 4],        // ile fragmentów na kość
    "length_au": [50, 90],      // długość kości
    "radius_au": [4, 7],        // promień trzonu
    "flare": 0.35,              // poszerzenie nasad na końcach (0.35 = o 35%)
    "ellipticity": 0.15,        // spłaszczenie przekroju (0 = okrągły)
    "bend_au": 2.0,             // wygięcie osi kości
    "bump_au": 0.25,            // nierówności kory (RMS)
    "tilt_deg": 35,             // największe pochylenie przełomu (0 = cięcie prostopadłe do osi)
    "relief_au": 1.2,           // duże nierówności przełomu (RMS, fale 3-10 a.u.) - im więcej, tym łatwiej dopasować
    "rough_au": 0.12,           // drobna szorstkość przełomu (RMS, fale 0.8-2 a.u.)
    "edge_au": 0.3,             // długość krawędzi siatki (gęstość skanu)
    "scan_noise_au": 0.02,      // szum skanera
    "holes": 0,                 // dziury w korze na fragment (miejsca niewidoczne dla skanera)
    "hole_au": [1.5, 3.0],      // promień dziury
    "colors": true,             // kolory: kora jasna, przełom ciemniejszy (false = bez kolorów)
    "chip_au": [2, 4],          // grubość płaskiego odłamka (cięcie "chip")
    "marrow": 0.0,              // kanał szpikowy: promień jako część promienia kości (0 = lita kość, np. 0.5);
                                // na przełomie skaner widzi go jako WKLĘSŁY dół, nie dziurę
    "marrow_depth_au": 3.0,     // głębokość tego dołu
    // Ręczny układ cięć zamiast losowego: lista na każdą kość, cięcia od dołu do góry -
    // "fracture" = zwykły przełom, "chip" = płaski odłamek między dwoma bliskimi przełomami.
    // Np. [["fracture", "chip"], ["fracture"]] = 2 kości (4 i 2 części). [] = losowo wg n_bones / fragments.
    // Gotowe układy: python scripts/make_synthetic.py --preset chip
    "layout": [],
    "seed": 0                   // ziarno losowania: to samo = ten sam zestaw
  },

  // -----------------
  // Prezentacja jednej metody - scripts/presentation.py (src/presentation.py)
  // -----------------
  "presentation": {
    // Które kroki ma strona (jednorazowo: --steps powierzchnie porownanie):
    //   "dane"         = skany -> kości (prepare_data.py),
    //   "powierzchnie" = kości z powierzchniami styku metody,
    //   "porownanie"   = algorytm vs ręczne oznaczenia (IoU / precyzja / czułość),
    //   "dopasowanie"  = dopasowanie końcowe (pary, macierz, złożenie) - wymaga match_surfaces.py.
    // Bez "dopasowanie" wystarczą powierzchnie (detect_contacts.py), plik: prezentacja_<metoda>_<kroki>.html
    "steps": ["dane", "powierzchnie", "porownanie", "dopasowanie"]
  },

  // -----------------
  // Wizualizacje 3D (pliki HTML w przeglądarce) - src/visualization_3d.py
  // -----------------
  "visualization_3d": {
    "triangles_total": 240000,  // trójkątów w całym HTML, dzielone między kości (więcej = dokładniej, większy plik)
    "embed_plotly": true,       // true = działa bez internetu; false = mniejszy plik, wymaga internetu
    "open_browser": true,       // otwórz wynik w przeglądarce

    // Które powierzchnie styku pokazuje show_bones.py (tak jak "source" w sekcji "matching"):
    //   "manual"      = ręczne (contacts/<zestaw>/<id>.json),
    //   "auto"        = z algorytmu (contacts/<zestaw>/auto/; gdy brak albo nieaktualne - liczone i zapisywane),
    //   "manual-auto" = ręczne, a dla kości bez ręcznych - z algorytmu.
    // Jednorazowo: python scripts/show_bones.py --source auto   (albo krócej: --auto)
    "source": "auto"
  }
}
